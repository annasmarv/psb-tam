# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
# PENTING: Jangan isi nilai asli di sini — file ini bisa masuk ke git repo.
# Set nilai asli di Cloudflare Pages dashboard:
# Dashboard → Pages → Project → Settings → Environment variables

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
APP_NAME=PSB SMK Tahasus Plus Al Mardliyah
APP_ENV=production

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Note: In Cloudflare Pages, set these as environment variables in:
# Dashboard → Pages → Your Project → Settings → Environment Variables
